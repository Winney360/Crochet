# Use http://localhost:5000/api for local development.
VITE_API_BASE_URL=http://localhost:5000/api

# EmailJS (https://www.emailjs.com/) - used by the contact form
VITE_SERVICE_ID=
VITE_TEMPLATE_ID=
VITE_PUBLIC_KEY=
