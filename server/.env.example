# Copy to .env and fill in. Never commit the real .env.

PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/crochet-website

# Long random string. Changing it invalidates all existing admin sessions.
JWT_SECRET=change_this_to_a_long_random_string

# Cloudinary (Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack - use sk_test_/pk_test_ for sandbox, sk_live_/pk_live_ for real money
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://your-site.com/order-success

# Only used by `npm run create-admin`
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Leave unset. Set to "true" only if you temporarily need POST /api/auth/register.
# ALLOW_ADMIN_REGISTRATION=true
